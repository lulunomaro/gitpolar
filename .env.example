# Must equal the URL used by LAN browsers and Git/LFS clients. No trailing path.
APP_ORIGIN=http://127.0.0.1:4317
HOST=0.0.0.0
PORT=4317
WORKSPACE_NAME=polar-lab
# For node server.mjs only; Docker always uses /data inside the container.
DATA_DIR=./data
# Docker Compose bind mount. Prefer a local filesystem on the NAS, not an SMB share.
NAS_DATA_DIR=./data
GITPOLAR_UID=1000
GITPOLAR_GID=1000
BIND_IP=0.0.0.0
# Maximum size per LFS object; default 20 GiB. Git pack uploads are streamed.
LFS_MAX_BYTES=21474836480
# Optional GitHub OAuth. Leave empty to use fully local accounts.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to join after initial setup. New users are writers.
GITHUB_ALLOWED_USERS=

# Browser STEP/STL preview size limit (128 MiB); independent of LFS storage limit.
PREVIEW_MAX_BYTES=134217728
