# Must equal the URL used by LAN browsers and Git/LFS clients. No trailing path.
APP_ORIGIN=http://127.0.0.1:4317
HOST=0.0.0.0
PORT=4317
WORKSPACE_NAME=polar-lab
# For node server.mjs only; Docker always uses /data inside the container.
DATA_DIR=./data
# Docker Compose bind mount. Prefer a local filesystem on the NAS, not an SMB share.
NAS_DATA_DIR=./data
GITPOLAR_UID=1000
GITPOLAR_GID=1000
BIND_IP=0.0.0.0
# Maximum size per LFS object; default 20 GiB. Git pack uploads are streamed.
LFS_MAX_BYTES=21474836480

# Browser STEP/STL preview size limit (128 MiB); independent of LFS storage limit.
PREVIEW_MAX_BYTES=134217728

# Feishu is the only web sign-in provider; callback is APP_ORIGIN/auth/feishu/callback.
# New members require an allowed tenant or open_id. Set designated project managers before the first deployment.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_TENANTS=
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ADMIN_OPEN_IDS=
# Existing Feishu Base receiving ledger (not the stock balance table). Grant app access first.
FEISHU_WAREHOUSE_BASE_TOKEN=
FEISHU_WAREHOUSE_TABLE_ID=
# JSON mapping for existing fields; see docs/PROCUREMENT.md. Empty uses documented Chinese names.
FEISHU_WAREHOUSE_FIELDS=
# Optional read-only stock balance table under the same Base.
FEISHU_INVENTORY_TABLE_ID=
FEISHU_INVENTORY_FIELDS=
# Set true to push pending receipts every minute after the connection is configured.
FEISHU_WAREHOUSE_AUTO_SYNC=false
