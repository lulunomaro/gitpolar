[Unit]
Description=Immich machine learning for Gitpolar albums
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/podman run --rm --pull=never --name=gitpolar-album-ml --network=host --user=65534:65534 --cap-drop=all --security-opt=no-new-privileges --volume=/var/cache/gitpolar-immich:/cache:rw --env=HOME=/tmp --env=IMMICH_HOST=127.0.0.1 --env=MACHINE_LEARNING_MODEL_INTRA_OP_THREADS=3 --env=MACHINE_LEARNING_MODEL_INTER_OP_THREADS=1 --env=MACHINE_LEARNING_REQUEST_THREADS=3 --env=OMP_NUM_THREADS=2 --env=RAYON_NUM_THREADS=2 ghcr.io/immich-app/immich-machine-learning@sha256:739405742a79bd7447227c553bb62ed5491aa36acf00bc667af7f9c93b6fae91
ExecStop=/usr/bin/podman stop --time=12 gitpolar-album-ml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
