[Unit]
Description=Gitpolar public relay (frps)
Wants=network-online.target
After=network-online.target

[Service]
User=gitpolar-relay
Group=gitpolar-relay
ExecStart=/opt/gitpolar-relay/frps -c /etc/gitpolar-relay/frps.toml
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
